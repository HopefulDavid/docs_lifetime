{
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "changelog.md",
          "toc.yml",
          "food/**/*.{md,yml}",
          "drink/**/*.{md,yml}"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/kitchen"
    ],
    "globalMetadata": {
      "_appName": "Dokumentace ze života",
      "_appTitle": "Život",
      "_enableSearch": true,
      "_lang": "cs",
      "_disableContribution": true,
      "pdf": true
    }
  }
}
